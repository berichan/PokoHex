<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <WasmEnableWebcil>true</WasmEnableWebcil>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <ProjectReference Include="..\PokoHex.Core\PokoHex.Core.csproj" />
  </ItemGroup>
  <Target Name="CopyWebSprites" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <ItemSprite Include="..\PokoHex\Resources\MenuIcon\*.png" />
      <VillagerSprite Include="..\PokoHex\Resources\Villager\*.png" />
    </ItemGroup>
    <Copy SourceFiles="@(ItemSprite)" DestinationFiles="@(ItemSprite->'wwwroot\images\items\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(VillagerSprite)" DestinationFiles="@(VillagerSprite->'wwwroot\images\villagers\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Include="wwwroot\images\**\*.png" Exclude="@(Content)" />
      <Content Update="wwwroot\images\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
