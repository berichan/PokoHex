<div class="item-select">
    <div class="item-preview"><Sprite Source="@SpriteUtil.GetItem(Selected?.Value ?? 0)" /><span>@Selected?.Display</span></div>
    <label>Search items:<input type="search" @bind="Search" @bind:event="oninput" placeholder="Name or item ID" /></label>
    <div class="item-choices" role="listbox" aria-label="Items">
        @foreach (var item in Filtered)
        {
            <button @key="item.Value" type="button" class="item-choice @(item.Value == Value ? "selected" : "")" role="option" aria-selected="@(item.Value == Value)" @onclick="() => ValueChanged.InvokeAsync(item.Value)">
                <Sprite Source="@SpriteUtil.GetItem(item.Value)" /><span>@item.Display</span>
            </button>
        }
        @if (Filtered.Length == 0)
        {
            <p class="muted">No matching items.</p>
        }
    </div>
    <small class="muted">Showing up to 80 matches. Search to narrow the list.</small>
</div>

@code {
    [Parameter, EditorRequired] public ItemInfo[] Choices { get; set; } = [];
    [Parameter] public ushort Value { get; set; }
    [Parameter] public EventCallback<ushort> ValueChanged { get; set; }
    [Parameter] public int Language { get; set; }
    private int PreviousLanguage = -1;
    private string Search = string.Empty;
    private ItemInfo[]? SearchChoices;
    private string[] SearchLabels = [];
    private (ItemInfo[] Choices, string Search)? FilterState;
    private ItemInfo[] Matches = [];
    private (ItemInfo[] Choices, ushort Value)? SelectionState;
    private ItemInfo? SelectedItem;
    private (ItemInfo[] Choices, ushort Value, string Search, int Language)? LastRender;
    private (ItemInfo[], ushort, string, int) GetRenderState() => (Choices, Value, Search, Language);
    protected override bool ShouldRender() => LastRender != GetRenderState();
    protected override void OnAfterRender(bool firstRender) => LastRender = GetRenderState();

    private ItemInfo? Selected
    {
        get
        {
            var state = (Choices, Value);
            if (SelectionState != state)
            {
                SelectedItem = Choices.FirstOrDefault(z => z.Value == Value);
                SelectionState = state;
            }
            return SelectedItem;
        }
    }

    private ItemInfo[] Filtered
    {
        get
        {
            var state = (Choices, Search);
            if (FilterState == state)
                return Matches;
            if (SearchChoices != Choices)
            {
                SearchLabels = Choices.Select(z => z.Display).ToArray();
                SearchChoices = Choices;
            }
            Matches = Choices.Where((_, i) => SearchLabels[i].Contains(Search, StringComparison.CurrentCultureIgnoreCase)).Take(80).ToArray();
            FilterState = state;
            return Matches;
        }
    }

    protected override void OnParametersSet()
    {
        if (PreviousLanguage != Language)
            Search = string.Empty;
        PreviousLanguage = Language;
    }
}
